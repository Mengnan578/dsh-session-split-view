{
  "name": "dsh-session-split-view",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-session split view for the DeepSeek Harness Web GUI: split the conversation panel into up to four live session panes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "split-view",
    "multi-session",
    "session",
    "web-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "dsh-session-split-view contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mengnan578/dsh-session-split-view.git"
  },
  "homepage": "https://github.com/Mengnan578/dsh-session-split-view#readme",
  "bugs": {
    "url": "https://github.com/Mengnan578/dsh-session-split-view/issues"
  }
}
